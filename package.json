{
  "name": "tailorbird_ui_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "RegressionRun": "npx playwright test",
    "test:full": "npx playwright test",
    "SanityRun": "npx playwright test --grep \"@sanity\"",
    "Test:headed": "npx playwright test --headed",
    "Test:login": "npx playwright test \"tests/TC01_login.spec.js\"",
    "Test:fullProperty": "cross-env OPTION=\"Creekstone at RTP\" npx playwright test --grep \"TC02\" --headed",
    "Test:loginLogout": "npx playwright test --grep \"TC01\"",
    "Test:menuNavigation": "npx playwright test --grep \"@menu\"",
    "Test:manageOrganizations": "npx playwright test --grep \"@organization\"",
    "Test:propertiesManagement": "npx playwright test --grep \"@property\"",
    "Test:projectsManagement": "npx playwright test --grep \"@project\"",
    "Test:jobsManagement": "npx playwright test --grep \"@job\"",
    "Test:categoryManagement": "npx playwright test --grep \"@category\"",
    "Test:invoice": "npx playwright test --grep \"@invoice\"",
    "Test:changeOrders": "npx playwright test --grep \"@changeOrder\"",
    "Test:mandatory": "npx playwright test --grep \"@mandatory\" --workers=1",
    "test:invertMandatory": "npm run RegressionRun -- --grep-invert @mandatory --workers=4 --retries=1",
    "test:bid": "npx playwright test --grep \"@bid\" --workers=1 --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harshalogy/Tailorbird_ui_automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Harshalogy/Tailorbird_ui_automation/issues"
  },
  "homepage": "https://github.com/Harshalogy/Tailorbird_ui_automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
